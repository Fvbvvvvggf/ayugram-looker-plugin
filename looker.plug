# -*- coding: utf-8 -*-\n\"\"\"\nThe Looker Plugin для Ayugram 12.10.6\nОтслеживание активности пользователей в публичных чатах и группах\n\"\"\"\n\nfrom typing import Any, Dict, List, Optional\nfrom datetime import datetime, timedelta\nimport sqlite3\nimport json\nfrom pathlib import Path\n\nfrom base_plugin import BasePlugin, MenuItemData, MenuItemType\nfrom ui.bulletin import BulletinHelper\n\n__id__ = \"the_looker\"\n__name__ = \"The Looker\"\n__description__ = \"🔍 Отслеживание активности пользователей в публичных чатах и истории их сообщений\"\n__author__ = \"Looker Dev\"\n__version__ = \"1.0.0\"\n__icon__ = \"msg_info\"\n__app_version__ = \">=12.5.1\"\n__sdk_version__ = \">=1.4.4.3\"\n\n# ============================================================================\n# DATABASE\n# ============================================================================\n\nclass ActivityDatabase:\n    \"\"\"База данных для хранения активности\"\"\"\n    \n    def __init__(self):\n        self.db_path = Path.home() / \".ayugram\" / \"looker\" / \"activity.db\"\n        self.db_path.parent.mkdir(parents=True, exist_ok=True)\n        self._init_db()\n    \n    def _init_db(self):\n        try:\n            conn = sqlite3.connect(self.db_path)\n            cursor = conn.cursor()\n            \n            # Таблица активности\n            cursor.execute(\"\"\"\n                CREATE TABLE IF NOT EXISTS activity (\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n                    username TEXT NOT NULL,\n                    user_id INTEGER,\n                    chat_id INTEGER NOT NULL,\n                    chat_title TEXT,\n                    message_id INTEGER,\n                    message_text TEXT,\n                    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n                    UNIQUE(username, chat_id, message_id)\n                )\n            \"\"\")\n            \n            # Таблица отслеживаемых пользователей\n            cursor.execute(\"\"\"\n                CREATE TABLE IF NOT EXISTS tracked_users (\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n                    username TEXT UNIQUE NOT NULL,\n                    added_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n                    enabled INTEGER DEFAULT 1\n                )\n            \"\"\")\n            \n            conn.commit()\n            conn.close()\n        except Exception as e:\n            pass\n    \n    def add_activity(self, username: str, user_id: int, chat_id: int, chat_title: str, \n                     message_id: int, message_text: str) -> bool:\n        try:\n            conn = sqlite3.connect(self.db_path)\n            cursor = conn.cursor()\n            cursor.execute(\"\"\"\n                INSERT OR IGNORE INTO activity \n                (username, user_id, chat_id, chat_title, message_id, message_text)\n                VALUES (?, ?, ?, ?, ?, ?)\n            \"\"\", (username.lower(), user_id, chat_id, chat_title, message_id, message_text[:500]))\n            conn.commit()\n            conn.close()\n            return True\n        except:\n            return False\n    \n    def add_tracked_user(self, username: str) -> bool:\n        try:\n            conn = sqlite3.connect(self.db_path)\n            cursor = conn.cursor()\n            username_clean = username.lower().lstrip(\"@\")\n            cursor.execute(\n                \"INSERT OR IGNORE INTO tracked_users (username) VALUES (?)\",\n                (username_clean,)\n            )\n            conn.commit()\n            conn.close()\n            return True\n        except:\n            return False\n    \n    def remove_tracked_user(self, username: str) -> bool:\n        try:\n            conn = sqlite3.connect(self.db_path)\n            cursor = conn.cursor()\n            username_clean = username.lower().lstrip(\"@\")\n            cursor.execute(\n                \"DELETE FROM tracked_users WHERE username = ?\",\n                (username_clean,)\n            )\n            conn.commit()\n            conn.close()\n            return True\n        except:\n            return False\n    \n    def get_tracked_users(self) -> List[str]:\n        try:\n            conn = sqlite3.connect(self.db_path)\n            cursor = conn.cursor()\n            rows = cursor.execute(\n                \"SELECT username FROM tracked_users WHERE enabled = 1\"\n            ).fetchall()\n            conn.close()\n            return [row[0] for row in rows]\n        except:\n            return []\n    \n    def get_user_activity(self, username: str, hours: int = 24) -> List[Dict]:\n        try:\n            conn = sqlite3.connect(self.db_path)\n            cursor = conn.cursor()\n            username_clean = username.lower().lstrip(\"@\")\n            cutoff_time = datetime.now() - timedelta(hours=hours)\n            \n            rows = cursor.execute(\"\"\"\n                SELECT username, chat_id, chat_title, message_text, timestamp\n                FROM activity\n                WHERE username = ? AND timestamp > ?\n                ORDER BY timestamp DESC\n            \"\"\", (username_clean, cutoff_time.isoformat())).fetchall()\n            \n            conn.close()\n            \n            return [\n                {\n                    \"username\": row[0],\n                    \"chat_id\": row[1],\n                    \"chat_title\": row[2],\n                    \"message\": row[3],\n                    \"timestamp\": row[4]\n                }\n                for row in rows\n            ]\n        except:\n            return []\n    \n    def get_activity_summary(self, username: str, hours: int = 24) -> Dict[str, Any]:\n        activities = self.get_user_activity(username, hours)\n        \n        by_chat = {}\n        for activity in activities:\n            chat = activity[\"chat_title\"]\n            by_chat[chat] = by_chat.get(chat, 0) + 1\n        \n        return {\n            \"username\": username.lower().lstrip(\"@\"),\n            \"total_messages\": len(activities),\n            \"active_chats\": len(by_chat),\n            \"by_chat\": by_chat,\n            \"last_seen\": activities[0][\"timestamp\"] if activities else None,\n            \"hours\": hours\n        }\n\n# ============================================================================\n# PLUGIN\n# ============================================================================\n\nclass TheLookerPlugin(BasePlugin):\n    def on_plugin_load(self):\n        self.db = ActivityDatabase()\n        self.logger.info(\"The Looker plugin loaded\")\n        \n        # Добавляем меню команды\n        self.add_menu_item(\n            MenuItemData(\n                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,\n                text=\"🔍 Проверить активность\",\n                on_click=self.check_message_activity,\n                icon=\"msg_info\",\n                subtext=\"Показать историю сообщений пользователя\",\n                priority=10,\n            )\n        )\n    \n    def on_message(self, message: Dict[str, Any]):\n        \"\"\"Обработка входящих сообщений\"\"\"\n        try:\n            # Проверяем есть ли информация об отправителе\n            from_user = message.get(\"from_user\") or message.get(\"sender\")\n            if not from_user:\n                return\n            \n            username = from_user.get(\"username\") or \"\"\n            user_id = from_user.get(\"id\") or 0\n            \n            if not username:\n                return\n            \n            # Проверяем отслеживается ли этот пользователь\n            tracked = self.db.get_tracked_users()\n            if username.lower().lstrip(\"@\") not in tracked:\n                return\n            \n            # Получаем информацию о чате\n            chat = message.get(\"chat\") or {}\n            chat_id = chat.get(\"id\") or 0\n            chat_title = chat.get(\"title\") or chat.get(\"username\") or \"Unknown\"\n            \n            # Сохраняем активность\n            message_text = message.get(\"text\") or message.get(\"caption\") or \"\"\n            message_id = message.get(\"message_id\") or 0\n            \n            self.db.add_activity(\n                username=username,\n                user_id=user_id,\n                chat_id=chat_id,\n                chat_title=chat_title,\n                message_id=message_id,\n                message_text=message_text\n            )\n        except Exception as e:\n            self.logger.error(f\"Error processing message: {e}\")\n    \n    def check_message_activity(self, context: Dict[str, Any]):\n        \"\"\"Проверить активность пользователя\"\"\"\n        try:\n            message = context.get(\"message\")\n            if not message:\n                self._show(\"❌ Не удалось получить информацию о сообщении\")\n                return\n            \n            # Получаем отправителя\n            from_user = message.get(\"from_user\") or message.get(\"sender\")\n            if not from_user:\n                self._show(\"❌ Не удалось определить отправителя сообщения\")\n                return\n            \n            username = from_user.get(\"username\") or from_user.get(\"first_name\") or \"Unknown\"\n            user_id = from_user.get(\"id\")\n            \n            # Получаем историю активности\n            summary = self.db.get_activity_summary(username, hours=24)\n            \n            if summary[\"total_messages\"] == 0:\n                self._show(\n                    f\"📊 **Пользователь @{username}**\\n\\n\"\n                    \"Нет записей об активности за последние 24 часа.\\n\\n\"\n                    \"Команда для отслеживания: /looker_add @{}\".format(username.lstrip(\"@\"))\n                )\n                return\n            \n            # Формируем ответ\n            response = f\"\"\"🔍 **The Looker - Активность @{username}**\n\n📊 **Статистика (24 часа):**\n• Всего сообщений: {summary['total_messages']}\n• Активных чатов: {summary['active_chats']}\n• Последний раз: {summary['last_seen']}\n\n💬 **По чатам:**\n\"\"\"\n            \n            for chat, count in sorted(summary['by_chat'].items(), key=lambda x: x[1], reverse=True)[:5]:\n                response += f\"\\n• {chat}: {count} сообщений\"\n            \n            response += f\"\\n\\n🔧 **Команды:**\\n/looker_add - добавить в отслеживание\\n/looker_list - список отслеживаемых\"\n            \n            self._show(response)\n        except Exception as e:\n            self.logger.error(f\"Error checking activity: {e}\")\n            self._show(f\"❌ Ошибка: {str(e)[:100]}\")\n    \n    def on_command(self, command: str, args: List[str]):\n        \"\"\"Обработка команд плагина\"\"\"\n        cmd = command.lower().strip(\"/\")\n        \n        if cmd == \"looker_add\":\n            if not args:\n                self._show(\"❌ Использование: /looker_add @username\")\n                return\n            username = args[0]\n            if self.db.add_tracked_user(username):\n                self._show(f\"✅ Добавлен @{username.lstrip('@')} в отслеживание\")\n            else:\n                self._show(f\"❌ Не удалось добавить @{username.lstrip('@')}\")\n        \n        elif cmd == \"looker_remove\":\n            if not args:\n                self._show(\"❌ Использование: /looker_remove @username\")\n                return\n            username = args[0]\n            if self.db.remove_tracked_user(username):\n                self._show(f\"✅ Удалён @{username.lstrip('@')} из отслеживания\")\n            else:\n                self._show(f\"❌ Не удалось удалить @{username.lstrip('@')}\")\n        \n        elif cmd == \"looker_list\":\n            users = self.db.get_tracked_users()\n            if not users:\n                self._show(\"📋 Нет отслеживаемых пользователей\")\n            else:\n                response = \"📋 **Отслеживаемые пользователи:**\\n\\n\"\n                for user in users:\n                    response += f\"• @{user}\\n\"\n                self._show(response)\n        \n        elif cmd == \"looker_status\":\n            if not args:\n                self._show(\"❌ Использование: /looker_status @username\")\n                return\n            username = args[0]\n            summary = self.db.get_activity_summary(username, hours=24)\n            \n            if summary[\"total_messages\"] == 0:\n                self._show(f\"❌ Нет активности @{username.lstrip('@')} за 24 часа\")\n            else:\n                response = f\"\"\"🟢 **@{username.lstrip('@')} - Активность**\n\n📊 Статистика:\n• Сообщений: {summary['total_messages']}\n• В чатах: {summary['active_chats']}\n• Последний: {summary['last_seen']}\"\"\"\n                self._show(response)\n        \n        elif cmd == \"looker_help\":\n            self._show(\"\"\"\n🔍 **The Looker - Справка**\n\n**Команды:**\n/looker_add @username - добавить в отслеживание\n/looker_remove @username - удалить из отслеживания\n/looker_status @username - показать статус\n/looker_list - список отслеживаемых\n/looker_help - эта справка\n\n📝 **Как использовать:**\n1. Добавьте пользователя: /looker_add @username\n2. Плагин будет записывать его сообщения в публичные чаты\n3. Проверьте активность командой или нажав на сообщение\n\"\"\")\n    \n    def _show(self, text: str):\n        \"\"\"Показать сообщение пользователю\"\"\"\n        try:\n            from ui.alert import AlertDialogBuilder\n            from client_utils import get_last_fragment\n            \n            fragment = get_last_fragment()\n            activity = fragment.getParentActivity() if fragment else None\n            if activity:\n                builder = AlertDialogBuilder(activity)\n                builder.set_title(\"The Looker\")\n                builder.set_message(text)\n                builder.set_positive_button(\"OK\", lambda b, w: b.dismiss())\n                builder.show()\n                return\n        except:\n            pass\n        \n        try:\n            BulletinHelper.show_info(text)\n        except:\n            self.logger.info(text)\n